# Client. For local dev without a real Firebase project, set VITE_DEV_AUTH=true
# and the server DEV_AUTH=true — the app will run with a mock user.
VITE_DEV_AUTH=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave empty to use the Vite dev proxy (same origin). Set for deployed API.
VITE_API_URL=
VITE_SOCKET_URL=
