# Server
PORT=4000
# Local MongoDB, or use a MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/trello-clone
# Client origin for CORS + Socket.io
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin. For local development without credentials, set DEV_AUTH=true
# and the server will accept any Bearer token as the user id (do NOT do this in production).
# FIREBASE_SERVICE_ACCOUNT_JSON accepts either the full JSON (single line) or a file path.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
DEV_AUTH=true
